# Portfolio environment configuration template.
#
# Copy to .env.local for local development. NEVER commit a populated .env.local.
# All values shown here are placeholders.

# Public canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://quantiviq.xyz

# GitHub username used for live contribution badges (no token required for public data).
NEXT_PUBLIC_GITHUB_USER=MajidAsghariTabrizi

# Optional GitHub personal access token (increases rate limit from 60 to 5000/hr).
# Only set this in the server runtime that produces the GitHub cache; never expose to the browser.
# GITHUB_TOKEN=

# Optional Plausible analytics (privacy-first). Leave empty to disable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=quantiviq.xyz